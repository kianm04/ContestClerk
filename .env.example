# Settings for docker-compose.yaml. Copy to `.env` beside it.
#
# These are not the same as client/.env, which is for `pnpm dev` on this machine.
# The difference is the addresses: `pnpm dev` and its browser are both on this
# machine and can say 127.0.0.1, while a visitor on munmeet.umarbek.dev cannot.

# Where the app is served. The tunnel forwards this hostname to the container.
# It has to match, or every form on the site is refused as cross-site.
ORIGIN=https://munmeet.umarbek.dev

# Supabase, as the *visitor's browser* will call it, because the value is
# compiled into the JavaScript it downloads. The tunnel publishes the local
# Supabase under this hostname, so it needs a public hostname on the tunnel's
# page in the Cloudflare dashboard, exactly like munmeet.umarbek.dev has.
PUBLIC_SUPABASE_URL=https://supabase-munmeet.umarbek.dev

# The local Supabase publishable key, printed by `pnpm db:status` as PUBLISHABLE
# KEY. It is the same on every machine and nothing about it is secret; Row Level
# Security is what keeps the data safe, not this key.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Stripe, read while the server runs. Leave them out and the Stripe pages say
# Stripe is not set up on this server. See client/.env.example.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# The Cloudflare tunnel this machine connects as. A remotely-managed tunnel keeps
# its hostname rules in the Cloudflare dashboard rather than in a file here, and
# this one token is what lets cloudflared fetch them. Copy it from the tunnel's
# page in the dashboard. Treat it as a password: anything holding it can serve
# traffic for our hostnames.
TUNNEL_TOKEN=
