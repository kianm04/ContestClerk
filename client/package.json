{
	"name": "client",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ --concurrency auto",
		"format": "prettier --write .",
		"test": "vitest run --project unit --project component --project harness",
		"test:watch": "vitest --project unit --project component --project harness",
		"test:db": "vitest run --project db",
		"test:e2e": "playwright test",
		"test:e2e:webkit": "MUNMEET_BROWSER=webkit playwright test",
		"verify": "node scripts/verify.mjs",
		"verify:fast": "node scripts/verify.mjs --fast",
		"house-rules": "node scripts/house-rules.mjs",
		"db:start": "supabase --workdir .. start",
		"db:stop": "supabase --workdir .. stop",
		"db:status": "supabase --workdir .. status",
		"db:reset": "supabase --workdir .. db reset",
		"db:types": "supabase --workdir .. gen types typescript --local > src/lib/database.types.ts",
		"test:scripts": "node --test scripts/*.test.mjs ../.claude/scripts/*.test.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24",
		"@types/sanitize-html": "^2.16.1",
		"bits-ui": "^2.19.4",
		"cn": "^0.4.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^27.4.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"supabase": "^2.117.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"@lucide/svelte": "^1.51.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.116.0",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@tiptap/core": "3.31.3",
		"@tiptap/extension-collaboration": "3.31.3",
		"@tiptap/extension-collaboration-caret": "3.31.3",
		"@tiptap/markdown": "3.31.3",
		"@tiptap/pm": "3.31.3",
		"@tiptap/starter-kit": "3.31.3",
		"@tiptap/y-tiptap": "3.0.9",
		"carbon-icons-svelte": "^13.16.0",
		"marked": "^17.0.6",
		"sanitize-html": "^2.18.1",
		"stripe": "^22.6.2",
		"y-protocols": "1.0.7",
		"yjs": "13.6.33"
	}
}
