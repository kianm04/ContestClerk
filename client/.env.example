# Copy to .env. For local development these are the values `pnpm db:status` prints
# after `pnpm db:start`; they are the same on every machine.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Printed by `pnpm db:status` as SECRET_KEY. The database tests use it to create
# rows that only database triggers may create; the app never reads it.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Nothing in the app needs these until an organisation connects a
# Stripe account on /manage/organizations/[orgSlug]; without them that page
# says Stripe is not set up on this server and offers no button, which is how
# every development machine and the browser tests run today. Get test-mode keys
# from the Stripe dashboard. STRIPE_WEBHOOK_SECRET is printed by
# `stripe listen --forward-to localhost:5173/api/stripe/webhook`.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PUBLIC_STRIPE_PUBLISHABLE_KEY=

# The address this site is reachable at, used to build the links Stripe and our
# emails send people back to. Leave it unset in development: the server reads
# the address of the request it is answering instead.
# PUBLIC_SITE_URL=
