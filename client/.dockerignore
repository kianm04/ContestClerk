# What `docker build` must not send to the daemon. Everything here is either
# rebuilt inside the image, useless to it, or a secret.

# Installed inside the image instead, for the image's own platform.
node_modules

# Build output, regenerated by `pnpm build` in the Dockerfile.
.svelte-kit
build

# Secrets. The PUBLIC_* values the build needs arrive as build arguments
# instead; see the comment in Dockerfile.
.env
.env.*
!.env.example

# Test and verification output from working on this machine.
test-results
playwright-report
blob-report
.verify-logs
